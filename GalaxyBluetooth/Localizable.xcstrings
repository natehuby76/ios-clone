      }
    },
    "Enable location for StarPilot Nav in iPhone Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa la ubicación para StarPilot Nav en Ajustes del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la localisation pour StarPilot Nav dans les réglages de l’iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 설정에서 StarPilot Nav의 위치를 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 设置中为 StarPilot Nav 启用定位。"
          }
        }
      }
    },
    "Enable Precise Location for StarPilot Nav in iPhone Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Ubicación precisa para StarPilot Nav en Ajustes del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la position exacte pour StarPilot Nav dans les réglages de l’iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 설정에서 StarPilot Nav의 정확한 위치를 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 设置中为 StarPilot Nav 启用精确位置。"
          }
        }
      }
    },
    "Still waiting for an accurate location. Try again with a clearer view of the sky.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún se espera una ubicación precisa. Inténtalo de nuevo con una vista más despejada del cielo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’une position précise. Réessayez avec une vue plus dégagée du ciel."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 위치를 기다리는 중입니다. 하늘이 잘 보이는 곳에서 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在等待准确位置，请在天空更开阔的地方重试。"
          }
        }
      }
    },
    "Refreshing your location. Tap Go again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizando tu ubicación. Vuelve a tocar Ir en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisation de votre position. Touchez Aller de nouveau dans un instant."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 새로 고치는 중입니다. 잠시 후 시작을 다시 탭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在刷新位置，请稍后再次轻点出发。"
          }
        }
      }
    },
    "Connect to comma, or switch off Send destination to comma.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a comma o desactiva Enviar destino a comma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à comma ou désactivez l’envoi de la destination à comma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "comma에 연결하거나 목적지를 comma로 보내기 옵션을 끄세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接 comma，或关闭向 comma 发送目的地。"
          }
        }
      }
    },
    "A different comma is paired. Use End on phone only.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otro comma vinculado. Usa Finalizar solo en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre comma est jumelé. Utilisez Terminer sur le téléphone uniquement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 comma가 연결되어 있습니다. 휴대전화에서만 종료를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对另一台 comma，请选择仅在手机上结束。"
          }
        }
      }
    },
    "Comma has a different destination now. Use End on phone only to leave it unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora comma tiene otro destino. Usa Finalizar solo en el teléfono para no cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma a maintenant une autre destination. Utilisez Terminer sur le téléphone uniquement pour la conserver."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "comma에 다른 목적지가 설정되어 있습니다. 변경하지 않으려면 휴대전화에서만 종료를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "comma 现在有另一个目的地。选择仅在手机上结束以保留它。"
          }
        }
      }
    },
    "Couldn’t confirm End Route on comma. Check its screen or choose End on phone only.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el fin de la ruta en comma. Comprueba su pantalla o elige Finalizar solo en el teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer la fin de l’itinéraire sur comma. Vérifiez son écran ou choisissez Terminer sur le téléphone uniquement."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "comma에서 경로 종료를 확인할 수 없습니다. 화면을 확인하거나 휴대전화에서만 종료를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认 comma 已结束路线。请查看其屏幕或选择仅在手机上结束。"
          }
        }
      }
    },
    "Route ended.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruta finalizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinéraire terminé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로가 종료되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路线已结束。"
          }
        }
      }
    },
    "Phone route ended. Comma was left unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruta del teléfono finalizada. Comma no se modificó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Itinéraire du téléphone terminé. Comma est inchangé."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화 경로가 종료되었습니다. comma는 변경되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机路线已结束，comma 未更改。"
          }
        }
      }
    },
    "Couldn’t disconnect Discord. Try again when online.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desconectar Discord. Inténtalo de nuevo cuando tengas conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déconnecter Discord. Réessayez une fois en ligne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord 연결을 해제할 수 없습니다. 온라인 상태에서 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法断开 Discord，请联网后重试。"
          }
        }
      }
    },
    "Couldn’t discard the saved report. Try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descartar el informe guardado. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer le rapport enregistré. Réessayez."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 보고서를 삭제할 수 없습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法丢弃已保存的报告，请重试。"
          }
        }
      }
    }
