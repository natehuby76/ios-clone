    "Advanced steering control changes to fine-tune how openpilot drives.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambios avanzados en el control de la dirección para ajustar cómo conduce openpilot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifications avancées de la direction pour régler finement le comportement d’openpilot."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "openpilot의 주행 방식을 세밀하게 조정하는 고급 조향 제어 변경입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于精细调整 openpilot 驾驶方式的高级转向控制设置。"
          }
        }
      }
    },
