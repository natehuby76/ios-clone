    "No places found. Try a more specific search.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron lugares. Prueba una búsqueda más específica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lieu trouvé. Essayez une recherche plus précise."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 찾을 수 없습니다. 더 구체적으로 검색하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到地点，请尝试更具体的搜索。"
