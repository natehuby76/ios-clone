    "Allow Local Network and Bluetooth when iPhone asks. We’ll find comma on your Wi-Fi or hotspot first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la red local y Bluetooth cuando el iPhone lo solicite. Primero buscaremos comma en tu Wi-Fi o punto de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le réseau local et Bluetooth lorsque l’iPhone le demande. Nous chercherons d’abord comma sur votre Wi-Fi ou point d’accès."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 요청하면 로컬 네트워크와 Bluetooth 접근을 허용하세요. 먼저 Wi-Fi 또는 핫스팟에서 comma를 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 提示时，请允许本地网络和蓝牙访问。我们会先在您的 Wi-Fi 或热点上查找 comma。"
          }
        }
      }
    },
    "Allow openpilot to change lanes.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que openpilot cambie de carril."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser openpilot à changer de voie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "openpilot이 차선을 변경하도록 허용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 openpilot 变道。"
          }
        }
      }
    },
    "Already says Connected? In Control Center, check whether comma is available as an audio output.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya dice Conectado? En el Centro de control, comprueba si comma está disponible como salida de audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà indiqué comme connecté? Dans le centre de contrôle, vérifiez si comma est disponible comme sortie audio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 연결됨으로 표시되나요? 제어 센터에서 comma가 오디오 출력으로 표시되는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已显示“已连接”？请在控制中心检查 comma 是否可用作音频输出。"
          }
        }
      }
    },
