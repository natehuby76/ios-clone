    "Navigation cleared on phone and comma.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegación borrada del teléfono y de comma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigation effacée sur le téléphone et sur comma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
