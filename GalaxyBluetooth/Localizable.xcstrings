        }
      }
    },
    "Couldn’t search places. Check your phone’s internet connection.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron buscar lugares. Comprueba la conexión a internet del teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche impossible. Vérifiez la connexion Internet de votre téléphone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 검색할 수 없습니다. 휴대전화의 인터넷 연결을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
