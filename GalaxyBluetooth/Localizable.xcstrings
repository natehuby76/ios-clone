          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous ci-dessus, puis touchez Utiliser le tunnel. Entrez votre mot de passe Galaxy sur cette page. L’app mémorise votre connexion, pas votre mot de passe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에서 로그인한 다음 터널 사용을 누르세요. 이 페이지에 Galaxy 비밀번호를 입력하세요. 앱은 비밀번호가 아닌 로그인 상태를 기억합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在上方登录，然后点击“使用隧道”。在此页面输入 Galaxy 密码。应用会记住登录状态，而非您的密码。"
